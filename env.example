# ─── Supabase ────────────────────────────────────────────────────────────────
# Encontre em: https://app.supabase.com → seu projeto → Settings → API

# URL do projeto (exposta no browser — segura)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave anônima pública (exposta no browser — segura)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ─── App ─────────────────────────────────────────────────────────────────────
# URL base da aplicação — usada para gerar links absolutos e o redirect do OAuth
NEXT_PUBLIC_SITE_URL=https://modarun.com.br

# ─── Cron (Vercel) ───────────────────────────────────────────────────────────
# Chave secreta para proteger o endpoint /api/cron/sync-eventos
# Gere com: openssl rand -hex 32
CRON_SECRET=sua_chave_secreta_aqui
